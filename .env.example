# LLM compiler integration.
# Set LLMWIKI_COMPILER_MODE=llm to enable LLM-enriched module pages.
# Defaults to "deterministic" (no LLM, no API key required).
LLMWIKI_COMPILER_MODE=

# API key for the LLM provider (required when LLMWIKI_COMPILER_MODE=llm).
LLMWIKI_LLM_API_KEY=

# LLM provider settings (all optional; defaults shown).
# LLMWIKI_LLM_PROVIDER=openai-compatible
# LLMWIKI_LLM_BASE_URL=https://api.openai.com/v1
# LLMWIKI_LLM_MODEL=gpt-4.1-mini
# LLMWIKI_LLM_TEMPERATURE=0.1
# LLMWIKI_LLM_MAX_OUTPUT_TOKENS=4000
# LLMWIKI_LLM_TIMEOUT_MS=60000
# LLMWIKI_LLM_RETRIES=2
# LLMWIKI_LLM_VALIDATION_RETRIES=1

# Optional for publishing to OWNER/REPO.wiki.git.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
