# Ignore all root dot files/directories by default; opt in the tracked ones below.
.*

# Tracked dot files and directories
!.gitignore
!.env.example
!.github/
!.github/**
!.llmwiki/
!.llmwiki/schema.md
!.pi/
!.pi/AGENTS.md
!.pi/agents/
!.pi/agents/**
!.pi/skills/
!.pi/skills/**

# Local pi/dev-loop runtime artifacts (ignored even though .pi/ is re-included)
.pi/settings.json
.pi/input-history.jsonl
.pi/runner-coordination/

# Dependencies
node_modules/

# Build artifacts
dist/
.tsbuildinfo
coverage/

# Generated local wiki/graph/search/run outputs
.llmwiki/run/
.llmwiki/wiki/
.llmwiki/graph.json
.llmwiki/search/
.llmwiki/bootstrap-plan.json
.llmwiki/incremental-plan.json
.llmwiki/plan.json

# OS
.DS_Store

# Scratch
tmp/
